# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=customer_events

# ---------- Airflow ----------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ---------- REST API ----------
API_BASE_URL=https://api.nbp.pl/api
API_TIMEOUT_SECONDS=10